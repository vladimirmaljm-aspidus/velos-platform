  // Relations
  tenant       Tenant        @relation(fields: [tenant_id], references: [id])
  partner      Partner       @relation(fields: [partner_id], references: [id])
  portalAccess PortalAccess? @relation(fields: [portal_access_id], references: [id])
  reviewer     User?         @relation("KycReviewer", fields: [reviewed_by], references: [id])
  documents    KycDocument[]

  @@index([tenant_id])
  @@index([partner_id])
  @@index([portal_access_id])
  @@index([status])
}

// ============================================================
// 34. KycDocument — KYC documents
// ============================================================
model KycDocument {
  id            String   @id @default(cuid())
  submission_id String
  type          String // passport | id_card | company_registration | tax_certificate | vat_certificate | bank_statement | utility_bill | beneficial_owner_declaration | trade_license | chamber_of_commerce | other
  filename      String
  storage_path  String
  mime_type     String
  size          Int
  uploaded_at   DateTime @default(now())

  // Relations
  submission KycSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)

  @@index([submission_id])
  @@index([type])
}

// ============================================================
// 35. PortalRfq — portal RFQs
// ============================================================
model PortalRfq {
  id               String  @id @default(cuid())
  tenant_id        String
  partner_id       String
  portal_access_id String?
  number           String  @unique // RFQ-2026-XXX
  status           String  @default("pending") // pending | quoted | accepted | declined | expired

  // What the client wants
  product_name        String
  product_description String?
  category            String? // from PRODUCT_CATEGORIES
  quantity            Float   @default(0)
  unit                String  @default("MT")
  target_price        Float?
  currency            String  @default("USD")

  // Delivery
  delivery_country String?
  delivery_port    String?
  delivery_date    DateTime?
  incoterm         String?

  // Additional
  specifications String?
  notes          String?

  // Admin response
  linked_offer_id  String?
  linked_demand_id String?
  admin_notes      String?

  // Meta
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  tenant       Tenant        @relation(fields: [tenant_id], references: [id])
  partner      Partner       @relation(fields: [partner_id], references: [id])
  portalAccess PortalAccess? @relation(fields: [portal_access_id], references: [id])
  linkedOffer  Offer?        @relation("RfqLinkedOffer", fields: [linked_offer_id], references: [id])
  linkedDemand Demand?       @relation("RfqLinkedDemand", fields: [linked_demand_id], references: [id])

  @@index([tenant_id])
  @@index([partner_id])
  @@index([portal_access_id])
  @@index([status])
  @@index([number])
}

// ============================================================
// 36. TenantFeatureFlags — feature flags per tenant
// ============================================================
model TenantFeatureFlags {
  id                           String   @id @default(cuid())
  tenant_id                    String   @unique
  // Module toggles
  module_crm                   Boolean  @default(true)
  module_trade                 Boolean  @default(false) // product catalog + supplier offers + trade calculator
  module_finance               Boolean  @default(true) // invoices + proformas
  module_inventory             Boolean  @default(false)
  module_portal                Boolean  @default(false) // client portal
  module_logistics             Boolean  @default(true) // freight quote requests + packing lists
  module_kyc                   Boolean  @default(false) // KYC verification
  module_document_templates    Boolean  @default(false)
  module_document_verification Boolean  @default(false) // QR + forensic
  module_vault                 Boolean  @default(false)
  module_api_keys              Boolean  @default(false)
  module_webhooks              Boolean  @default(false)
  module_mail_queue            Boolean  @default(false)
  module_security              Boolean  @default(false) // security center
  // Feature limits
  max_partners                 Int      @default(999999) // 999999 = effectively unlimited
  max_users                    Int      @default(5)
  max_monthly_documents        Int      @default(999999) // 999999 = effectively unlimited
  // Beta features
  beta_ai_assistant            Boolean  @default(false)
  beta_advanced_analytics      Boolean  @default(false)
  // Meta
  updated_by                   String?
  updated_at                   DateTime @updatedAt

  // Relations
  tenant  Tenant @relation(fields: [tenant_id], references: [id])
  updater User?  @relation("FlagUpdater", fields: [updated_by], references: [id])

  @@index([tenant_id])
}

// ============================================================
// 37. Notification — in-app notifications
// ============================================================
model Notification {
  id           String    @id @default(cuid())
  tenant_id    String
  user_id      String? // null = broadcast to all tenant users
  type         String // kyc_submitted | kyc_approved | kyc_rejected | rfq_received | rfq_quoted | offer_sent | offer_accepted | offer_rejected | offer_expired | invoice_overdue | invoice_paid | document_shared | portal_access_requested | portal_access_approved | portal_invite_sent | task_assigned | task_due_soon | low_stock_alert | system_message | marketplace_response_received | marketplace_response_accepted | marketplace_response_rejected | marketplace_message_received
  title        String
  message      String
  entity_type  String?
  entity_id    String?
  read         Boolean   @default(false)
  read_at      DateTime?
  // Metadata for action buttons
  action_url   String?
  action_label String?
  created_at   DateTime  @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenant_id], references: [id])
  user   User?  @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([user_id])
  @@index([type])
  @@index([read])
  @@index([created_at])
  @@index([entity_type, entity_id])
}

// ============================================================
// 38. ErpAccount — Chart of Accounts (Kontni plan)
// ============================================================
model ErpAccount {
  id               String   @id @default(cuid())
  tenant_id        String
  code             String // account code like "1000", "2000" etc.
  name             String // account name
  name_en          String? // English name
  account_type     String // asset, liability, equity, revenue, expense
  account_category String? // current_asset, fixed_asset, current_liability, etc.
  parent_id        String? // self-reference for hierarchy
  is_active        Boolean  @default(true)
  is_system        Boolean  @default(false) // system accounts can't be deleted
  standard         String? // eu, uae - which standard this follows
  tax_code         String? // for tax-related accounts
  description      String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  // Relations
  parent        ErpAccount?      @relation("AccountHierarchy", fields: [parent_id], references: [id])
  children      ErpAccount[]     @relation("AccountHierarchy")
  journal_lines ErpJournalLine[]
  bank_accounts ErpBankAccount[]
  tenant        Tenant           @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([code])
  @@index([account_type])
}

// ============================================================
// 39. FiscalPeriod — Fiscal/calendar periods
// ============================================================
model FiscalPeriod {
  id          String    @id @default(cuid())
  tenant_id   String
  name        String // e.g., "Q1 2025", "January 2025"
  start_date  DateTime
  end_date    DateTime
  period_type String // monthly, quarterly, yearly
  status      String    @default("open") // open, closed, locked
  fiscal_year Int
  closed_by   String? // user who closed
  closed_at   DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  // Relations
  journal_entries ErpJournalEntry[]
  tenant          Tenant            @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([fiscal_year])
  @@index([status])
}

// ============================================================
// 40. ErpJournalEntry — Journal entries (header)
// ============================================================
model ErpJournalEntry {
  id               String    @id @default(cuid())
  tenant_id        String
  entry_number     String // auto-generated like "JE-2025-001"
  date             DateTime
  description      String
  reference_type   String? // deal, invoice, proforma, commission, manual, bank
  reference_id     String? // linked entity ID
  fiscal_period_id String?
  status           String    @default("draft") // draft, posted, reversed, cancelled
  source_type      String? // auto, manual - auto = system-generated
  debit_total      Float     @default(0)
  credit_total     Float     @default(0)
  currency         String    @default("EUR")
  exchange_rate    Float     @default(1)
  notes            String?
  created_by       String
  posted_by        String?
  posted_at        DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  // Relations
  lines             ErpJournalLine[]
  fiscal_period     FiscalPeriod?        @relation(fields: [fiscal_period_id], references: [id])
  bank_transactions ErpBankTransaction[]
  tenant            Tenant               @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, entry_number])
  @@index([tenant_id])
  @@index([entry_number])
  @@index([status])
  @@index([date])
  @@index([reference_type, reference_id])
}

// ============================================================
// 41. ErpJournalLine — Journal entry lines (debit/credit)
// ============================================================
model ErpJournalLine {
  id               String   @id @default(cuid())
  tenant_id        String
  journal_entry_id String
  account_id       String
  line_number      Int
  description      String?
  debit            Float    @default(0)
  credit           Float    @default(0)
  currency         String   @default("EUR")
  partner_id       String? // for sub-ledger tracking
  cost_center_id   String?
  created_at       DateTime @default(now())

  // Relations
  tenant        Tenant          @relation("JLTenant", fields: [tenant_id], references: [id])
  journal_entry ErpJournalEntry @relation(fields: [journal_entry_id], references: [id])
  account       ErpAccount      @relation(fields: [account_id], references: [id])
  cost_center   ErpCostCenter?  @relation(fields: [cost_center_id], references: [id])
  partner       Partner?        @relation(fields: [partner_id], references: [id])

  @@index([tenant_id])
  @@index([journal_entry_id])
  @@index([account_id])
  @@index([partner_id])
  @@index([cost_center_id])
}

// ============================================================
// 42. ErpCostCenter — Cost centers
// ============================================================
model ErpCostCenter {
  id          String   @id @default(cuid())
  tenant_id   String
  code        String
  name        String
  parent_id   String? // self-reference
  is_active   Boolean  @default(true)
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  parent        ErpCostCenter?   @relation("CostCenterHierarchy", fields: [parent_id], references: [id])
  children      ErpCostCenter[]  @relation("CostCenterHierarchy")
  journal_lines ErpJournalLine[]
  tenant        Tenant           @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([code])
}

// ============================================================
// 43. ErpBankAccount — Bank accounts
// ============================================================
model ErpBankAccount {
  id             String   @id @default(cuid())
  tenant_id      String
  account_id     String // linked to chart of accounts
  bank_name      String
  account_number String
  iban           String?
  swift_bic      String?
  currency       String   @default("EUR")
  balance        Float    @default(0)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // Relations
  account      ErpAccount           @relation(fields: [account_id], references: [id])
  transactions ErpBankTransaction[]
  tenant       Tenant               @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([account_id])
}

// ============================================================
// 44. ErpBankTransaction — Bank transactions
// ============================================================
model ErpBankTransaction {
  id                   String   @id @default(cuid())
  tenant_id            String
  bank_account_id      String
  date                 DateTime
  amount               Float
  transaction_type     String // debit, credit
  description          String?
  reference            String?
  counterparty         String?
  counterparty_account String?
  is_reconciled        Boolean  @default(false)
  reconciled_with      String? // journal entry ID
  journal_entry_id     String? // auto-created journal entry
  created_at           DateTime @default(now())

  // Relations
  bank_account  ErpBankAccount   @relation(fields: [bank_account_id], references: [id])
  journal_entry ErpJournalEntry? @relation(fields: [journal_entry_id], references: [id])
  tenant        Tenant           @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([bank_account_id])
  @@index([date])
  @@index([is_reconciled])
}

// ============================================================
// 46. UserPreference — per-user preference key-value pairs
// ============================================================
model UserPreference {
  id               String   @id @default(cuid())
  user_id          String
  preference_key   String
  preference_value String // JSON-serialized value
  updated_at       DateTime @updatedAt

  // Relations
  user User @relation(fields: [user_id], references: [id])

  @@unique([user_id, preference_key])
  @@index([user_id])
  @@index([preference_key])
}

// ============================================================
// 45. ErpSetting — ERP-specific settings
// ============================================================
model ErpSetting {
  id                      String   @id @default(cuid())
  tenant_id               String   @unique
  accounting_standard     String   @default("eu") // eu, uae
  fiscal_year_start       String   @default("01-01") // MM-DD
  fiscal_year_end         String   @default("12-31") // MM-DD
  default_currency        String   @default("EUR")
  vat_enabled             Boolean  @default(true)
  vat_rate                Float    @default(20.0) // default VAT rate
  vat_return_period       String   @default("monthly") // monthly, quarterly, yearly
  auto_post_journal       Boolean  @default(true) // auto-post from deals/invoices
  revenue_account_id      String?
  expense_account_id      String?
  receivable_account_id   String?
  payable_account_id      String?
  vat_account_id          String?
  bank_charges_account_id String?
  cash_account_id         String?
  retention_account_id    String?
  round_off_account_id    String?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
}

model Plan {
  id                    String   @id @default(cuid())
  name                  String   @unique
  description           String?
  price_monthly         Float    @default(0)
  price_yearly          Float    @default(0)
  currency              String   @default("EUR")
  max_users             Int      @default(5)
  max_partners          Int      @default(999999)
  max_monthly_documents Int      @default(999999)
  max_products          Int      @default(999999)
  storage_mb            Int      @default(500)
  trial_days            Int      @default(15)
  included_modules      String   @default("[]")
  custom_branding       Boolean  @default(false)
  api_access            Boolean  @default(false)
  priority_support      Boolean  @default(false)
  white_label           Boolean  @default(false)
  is_active             Boolean  @default(true)
  is_public             Boolean  @default(true)
  sort_order            Int      @default(0)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@index([is_active])
}

model ModuleGroup {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  icon        String?
  color       String?
  modules     String   @default("[]")
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}
