// VELOS Trade Management Platform — Prisma Schema
// SQLite-compatible: no enums, no native JSON/arrays (stored as String)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. Tenant — multi-tenant company
// ============================================================
model Tenant {
  id                  String    @id @default(cuid())
  name                String
  legal_name          String?
  country             String? // ISO 3166-1 alpha-2
  currency            String // default currency
  tax_id              String?
  vat_number          String?
  registration_number String?
  address_line        String?
  city                String?
  postal_code         String?
  // Contact (shown in PDF footer + portal)
  website             String?
  phone               String?
  email               String?
  // Bank details (for invoices)
  bank_name           String?
  bank_accounts       Json? // JSONB array of {bank_name, iban, swift, ...}
  bank_iban           String?
  bank_swift          String?
  // Branding
  logo_url            String?
  primary_color       String?
  // Subscription
  plan                String    @default("trial") // trial | starter | business | enterprise
  status              String    @default("active") // active | suspended | cancelled
  max_users           Int       @default(5)
  subscription_start  DateTime?
  subscription_end    DateTime?
  trial_ends_at       DateTime?
  billing_cycle       String? // monthly | yearly
  amount_paid         Float?
  currency_paid       String?
  trial_days          Int?
  // Meta
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  // Relations
  users                 User[]
  partners              Partner[]
  productCatalogEntries ProductCatalogEntry[]
  supplierOffers        SupplierOffer[]
  tradeCalculations     TradeCalculation[]
  portalAccesses        PortalAccess[]
  documentTemplates     DocumentTemplate[]
  documentVerifications DocumentVerification[]
  kycSubmissions        KycSubmission[]
  portalRfqs            PortalRfq[]
  featureFlags          TenantFeatureFlags[]
  notifications         Notification[]
  erpAccounts           ErpAccount[]
  fiscalPeriods         FiscalPeriod[]
  erpJournalEntries     ErpJournalEntry[]
  erpCostCenters        ErpCostCenter[]
  erpBankAccounts       ErpBankAccount[]
  erpBankTransactions   ErpBankTransaction[]
  erpJournalLines       ErpJournalLine[]       @relation("JLTenant")
  documentRevisions     DocumentRevision[]     @relation("DocRevTenant")
  erpSetting            ErpSetting?
  letterheads           TenantLetterhead[]
  seals                 TenantSeal[]
  invoices              Invoice[]
  proformas             Proforma[]
}

// ============================================================
// 2. User — platform users
// ============================================================
model User {
  id                   String    @id @default(cuid())
  tenant_id            String?
  username             String
  email                String    @unique
  full_name            String?
  role                 String    @default("staff") // super_admin | admin | manager | staff | viewer
  permissions          String? // JSON array of strings
  password_hash        String
  totp_secret          String?
  totp_enabled         Boolean   @default(false)
  // SHA-256 hex strings for 10 one-time 2FA recovery codes (migration 040
  // / src/lib/auth/totp.ts `hashRecoveryCode`). Hashed at the application
  // layer so a DB read alone can't recover usable codes. NULL when 2FA is
  // not active. Stored as TEXT (JSON array) — SQLite has no native JSON.
  recovery_codes       String?
  locked_until         DateTime?
  failed_attempts      Int       @default(0)
  last_login_at        DateTime?
  last_login_ip        String?
  last_login_country   String?
  must_change_password Boolean   @default(false)
  token_version        Int       @default(1)
  signature            String? // base64 signature image
  notif_prefs          String? // JSON object
  active               Boolean   @default(true)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  // Relations
  tenant                  Tenant?                 @relation(fields: [tenant_id], references: [id])
  deals                   Deal[]                  @relation("DealOwner")
  offers                  Offer[]                 @relation("OfferOwner")
  uploadedDocuments       SharedDocument[]
  auditLogs               AuditLog[]
  tasks                   UserTask[]
  entityNotes             EntityNote[]
  securitySessions        SecuritySession[]
  loginHistory            LoginHistoryEntry[]
  knownIps                KnownIp[]
  trustedDevices          TrustedDevice[]
  tradeCalculations       TradeCalculation[]      @relation("TradeCalcCreator")
  documentRegisterEntries DocumentRegisterEntry[]
  documentRevisions       DocumentRevision[]      @relation("DocRevCreator")
  documentTemplates       DocumentTemplate[]      @relation("TemplateCreator")
  approvedPortalAccess    PortalAccess[]          @relation("PortalApprover")
  reviewedKyc             KycSubmission[]         @relation("KycReviewer")
  notifications           Notification[]
  featureFlagUpdater      TenantFeatureFlags[]    @relation("FlagUpdater")
  preferences             UserPreference[]
  letterheadsCreated      TenantLetterhead[]      @relation("LetterheadCreator")
  sealsCreated            TenantSeal[]            @relation("SealCreator")

  @@index([tenant_id])
  @@index([email])
  @@index([role])
  @@index([active])
}

// ============================================================
// 3. Partner — trading partners
// ============================================================
model Partner {
  id                      String    @id @default(cuid())
  tenant_id               String
  name                    String
  entity_type             String    @default("company") // company | individual
  type                    String    @default("both") // supplier | buyer | both | agent | logistics | customs | bank | inspector
  email                   String?
  phone                   String?
  website                 String?
  tax_id                  String?
  vat_number              String?
  registration_number     String?
  // Address
  address_line            String?
  city                    String?
  state                   String?
  postal_code             String?
  country                 String? // ISO 3166-1 alpha-2
  // Contact person
  contact_name            String?
  contact_email           String?
  contact_phone           String?
  // Bank
  bank_name               String?
  bank_account            String?
  bank_swift              String?
  bank_iban               String?
  // Trade
  preferred_currency      String?
  preferred_incoterm      String?
  preferred_payment_terms String?
  // CRM
  status                  String    @default("active") // active | inactive | blacklisted
  risk_score              Int       @default(0)
  notes                   String?
  tags                    String? // JSON array of strings
  // Portal
  portal_enabled          Boolean   @default(false)
  portal_token            String?
  portal_level            String    @default("none") // none | viewer | buyer
  kyc_status              String    @default("not_submitted") // not_submitted | pending | approved | rejected
  kyc_data                String? // JSON object
  kyc_reviewed_by         String?
  kyc_reviewed_at         DateTime?
  // Meta
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  // Relations
  tenant                      Tenant                  @relation(fields: [tenant_id], references: [id])
  deals                       Deal[]
  offers                      Offer[]
  demands                     Demand[]
  sharedDocuments             SharedDocument[]
  inventoryMovements          InventoryMovement[]
  invoices                    Invoice[]
  proformas                   Proforma[]
  supplierOffers              SupplierOffer[]         @relation("SupplierOfferSupplier")
  tradeCalculationsAsSupplier TradeCalculation[]      @relation("TradeCalcSupplier")
  tradeCalculationsAsBuyer    TradeCalculation[]      @relation("TradeCalcBuyer")
  portalAccesses              PortalAccess[]
  documentVerifications       DocumentVerification[]  @relation("VerificationPartner")
  kycSubmissions              KycSubmission[]
  portalRfqs                  PortalRfq[]
  documentRegisterEntries     DocumentRegisterEntry[]
  journalLines                ErpJournalLine[]

  @@index([tenant_id])
  @@index([type])
  @@index([status])
  @@index([name])
}

// ============================================================
// 4. Product — simple product catalog
// ============================================================
model Product {
  id            String   @id @default(cuid())
  tenant_id     String
  sku           String
  name          String
  description   String?
  category      String?
  unit          String
  price         Float
  currency      String
  cost          Float?
  stock         Int      @default(0)
  reorder_level Int      @default(0)
  active        Boolean  @default(true)
  attributes    String? // JSON object
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  inventoryMovements InventoryMovement[]
  offers             Offer[]             @relation("OfferProduct")

  @@index([tenant_id])
  @@index([sku])
  @@index([category])
  @@index([active])
}

// ============================================================
// 5. Deal — deals with stages
// ============================================================
model Deal {
  id             String    @id @default(cuid())
  tenant_id      String
  title          String
  partner_id     String
  owner_id       String?
  stage          String    @default("lead") // lead | qualified | proposal | negotiation | won | lost
  value          Float     @default(0)
  currency       String    @default("USD")
  expected_close DateTime?
  probability    Int       @default(0)
  description    String?
  lost_reason    String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  // Relations
  partner Partner @relation(fields: [partner_id], references: [id])
  owner   User?   @relation("DealOwner", fields: [owner_id], references: [id])
  offers  Offer[]

  @@index([tenant_id])
  @@index([partner_id])
  @@index([owner_id])
  @@index([stage])
}

// ============================================================
// 6. Offer — offers with line items (JSON)
// ============================================================
model Offer {
  id             String    @id @default(cuid())
  tenant_id      String
  number         String    @unique
  deal_id        String?
  partner_id     String
  owner_id       String?
  status         String    @default("draft") // draft | sent | accepted | rejected | expired
  subject        String
  currency       String    @default("USD")
  subtotal       Float     @default(0)
  discount_total Float     @default(0)
  tax_total      Float     @default(0)
  total          Float     @default(0)
  notes          String?
  terms          String?
  valid_until    DateTime?
  sent_at        DateTime?
  responded_at   DateTime?
  items          String // JSON array of OfferLineItem

  // Trade / import fields
  offer_no      String? // supplier's own reference number
  bank_details  String? // bank name & IBAN
  pol           String? // port of loading
  pod           String? // port of discharge
  vessel        String? // vessel name
  container_no  String? // container number
  lead_time     String? // e.g. "14 days"
  packaging     String? // e.g. "50 kg PP bags"
  payment_terms String? // e.g. "net30", "LC at sight"
  tax_clause    String? // e.g. "VAT reverse charge"
  incoterm      String? // EXW, FOB, CIF, etc.
  selling_price Float? // per-unit selling price

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Trade / import fields (synced with live DB)
  product_id       String? // linked product (FK to Product)
  services         String? // JSON array of service line items
  payment_bank_idx Int? // index into tenant bank_accounts JSON
  pol_country      String? // country of port of loading
  pod_country      String? // country of port of discharge
  delivery_address String?
  delivery_city    String?
  delivery_country String?
  specification    String?
  origin_country   String?
  quantity         Float   @default(0)
  unit             String  @default("MT")

  // Multi-currency (synced with live DB)
  exchange_rate      Float?
  exchange_rate_date DateTime?
  exchange_rate_note String?

  // Portal view tracking & client acceptance (synced with live DB)
  viewed_at                DateTime?
  viewed_by_email          String?
  view_count               Int       @default(0)
  client_accepted_at       DateTime?
  client_signature         String?
  client_note              String?
  admin_reviewed_by_client Boolean   @default(false)

  // Audit / soft delete (synced with live DB)
  old_id     String?
  deleted_at DateTime?
  version    Int       @default(1)

  // PDF / document register (synced with live DB)
  pdf_file_url     String?
  pdf_generated_at DateTime?
  document_id      String?

  // Relations
  deal       Deal?       @relation(fields: [deal_id], references: [id])
  partner    Partner     @relation(fields: [partner_id], references: [id])
  owner      User?       @relation("OfferOwner", fields: [owner_id], references: [id])
  product    Product?    @relation("OfferProduct", fields: [product_id], references: [id])
  invoices   Invoice[]
  proformas  Proforma[]
  portalRfqs PortalRfq[] @relation("RfqLinkedOffer")

  @@index([tenant_id])
  @@index([deal_id])
  @@index([partner_id])
  @@index([owner_id])
  @@index([status])
  @@index([product_id])
  @@index([deleted_at])
}

// ============================================================
// 7. Demand — demands with items (JSON)
// ============================================================
model Demand {
  id                 String    @id @default(cuid())
  tenant_id          String
  number             String    @unique
  partner_id         String
  status             String    @default("open") // open | quoted | closed
  priority           String    @default("medium") // low | medium | high
  subject            String
  description        String?
  requested_delivery DateTime?
  currency           String    @default("EUR")
  items              String // JSON array of DemandItem

  // Trade / import fields
  product_id     String? // linked product
  product_name   String? // denormalized product name
  target_price   Float? // target price per unit
  is_new_product Boolean   @default(false)
  source         String? // e.g. "portal", "manual", "import"
  auto_hints     String? // JSON: auto-suggestions
  buyer_bank     String? // buyer's bank details
  destination    String? // delivery destination
  needed_by      DateTime? // needed-by date
  payment_terms  String? // e.g. "net30", "LC at sight"

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  partner    Partner     @relation(fields: [partner_id], references: [id])
  portalRfqs PortalRfq[] @relation("RfqLinkedDemand")

  @@index([tenant_id])
  @@index([partner_id])
  @@index([status])
}

// ============================================================
// 8. SharedDocument — file attachments
// ============================================================
model SharedDocument {
  id                 String   @id @default(cuid())
  tenant_id          String
  partner_id         String
  filename           String
  mime_type          String
  size               Int
  storage_path       String
  category           String   @default("other") // contract | invoice | spec | other
  uploaded_by        String?
  visible_to_partner Boolean  @default(false)
  created_at         DateTime @default(now())

  // Relations
  partner  Partner @relation(fields: [partner_id], references: [id])
  uploader User?   @relation(fields: [uploaded_by], references: [id])

  @@index([tenant_id])
  @@index([partner_id])
  @@index([category])
  @@index([uploaded_by])
}

// ============================================================
// 9. AuditLog — audit trail
// ============================================================
model AuditLog {
  id          String   @id @default(cuid())
  tenant_id   String?
  user_id     String?
  username    String?
  action      String
  entity_type String?
  entity_id   String?
  details     String? // JSON object
  ip          String?
  user_agent  String?
  created_at  DateTime @default(now())

  // Relations
  user User? @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([user_id])
  @@index([action])
  @@index([entity_type, entity_id])
  @@index([created_at])
}

// ============================================================
// 10. Setting — key-value settings
// ============================================================
model Setting {
  id         String   @id @default(cuid())
  tenant_id  String?
  key        String
  value      String // JSON-serialized value
  updated_at DateTime @updatedAt

  @@unique([tenant_id, key])
  @@index([tenant_id])
}

// ============================================================
// 11. UserTask — user tasks
// ============================================================
model UserTask {
  id          String    @id @default(cuid())
  tenant_id   String
  user_id     String
  title       String
  done        Boolean   @default(false)
  due_date    DateTime?
  entity_type String?
  entity_id   String?
  priority    String    @default("medium") // low | medium | high
  created_at  DateTime  @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([user_id])
  @@index([done])
  @@index([due_date])
  @@index([entity_type, entity_id])
}

// ============================================================
// 12. InventoryMovement — inventory tracking
// ============================================================
model InventoryMovement {
  id         String   @id @default(cuid())
  tenant_id  String
  partner_id String
  product_id String
  delta      Int
  reason     String
  reference  String?
  created_at DateTime @default(now())

  // Relations
  partner Partner @relation(fields: [partner_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])

  @@index([tenant_id])
  @@index([partner_id])
  @@index([product_id])
  @@index([created_at])
}

// ============================================================
// 13. EntityNote — notes on entities
// ============================================================
model EntityNote {
  id          String   @id @default(cuid())
  tenant_id   String
  entity_type String
  entity_id   String
  content     String
  pinned      Boolean  @default(false)
  created_by  String?
  created_at  DateTime @default(now())

  // Relations
  creator User? @relation(fields: [created_by], references: [id])

  @@index([tenant_id])
  @@index([entity_type, entity_id])
  @@index([created_by])
  @@index([pinned])
}

// ============================================================
// 14. Invoice — invoices with items (JSON)
// ============================================================
model Invoice {
  id             String    @id @default(cuid())
  tenant_id      String
  number         String    @unique
  offer_id       String?
  partner_id     String
  status         String    @default("draft") // draft | sent | paid | overdue | cancelled
  subject        String
  currency       String    @default("USD")
  subtotal       Float     @default(0)
  discount_total Float     @default(0)
  tax_total      Float     @default(0)
  total          Float     @default(0)
  issue_date     DateTime
  due_date       DateTime
  sent_at        DateTime?
  paid_at        DateTime?
  notes          String?
  items          String // JSON array of OfferLineItem
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  // Trade / import fields (synced with live DB)
  incoterm         String?
  pol              String? // port of loading
  pol_country      String?
  pod              String? // port of discharge
  pod_country      String?
  vessel           String?
  container_no     String?
  lead_time        String?
  packaging        String?
  delivery_address String?
  delivery_city    String?
  delivery_country String?
  specification    String?
  origin_country   String?

  // Multi-currency (synced with live DB)
  exchange_rate      Float?
  exchange_rate_date DateTime?
  exchange_rate_note String?

  // Portal view tracking (synced with live DB)
  viewed_at       DateTime?
  viewed_by_email String?
  view_count      Int       @default(0)

  // Audit / soft delete (synced with live DB)
  deleted_at DateTime?
  version    Int       @default(1)

  // Relations
  tenant  Tenant  @relation(fields: [tenant_id], references: [id])
  offer   Offer?  @relation(fields: [offer_id], references: [id])
  partner Partner @relation(fields: [partner_id], references: [id])

  @@index([tenant_id])
  @@index([offer_id])
  @@index([partner_id])
  @@index([status])
  @@index([due_date])
  @@index([deleted_at])
}

// ============================================================
// 15. Proforma — proformas with items (JSON)
// ============================================================
model Proforma {
  id             String    @id @default(cuid())
  tenant_id      String
  number         String    @unique
  offer_id       String?
  partner_id     String
  status         String    @default("draft") // draft | sent | paid | expired
  subject        String
  currency       String    @default("EUR")
  subtotal       Float     @default(0)
  discount_total Float     @default(0)
  tax_total      Float     @default(0)
  total          Float     @default(0)
  issue_date     DateTime
  valid_until    DateTime
  sent_at        DateTime?
  paid_at        DateTime?
  payment_terms  String?   @default("net30")
  notes          String?
  items          String // JSON array of OfferLineItem
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  // Trade / import fields (synced with live DB)
  incoterm         String?
  pol              String? // port of loading
  pol_country      String?
  pod              String? // port of discharge
  pod_country      String?
  vessel           String?
  container_no     String?
  lead_time        String?
  packaging        String?
  delivery_address String?
  delivery_city    String?
  delivery_country String?
  specification    String?
  origin_country   String?

  // Multi-currency (synced with live DB)
  exchange_rate      Float?
  exchange_rate_date DateTime?
  exchange_rate_note String?

  // Portal view tracking (synced with live DB)
  viewed_at       DateTime?
  viewed_by_email String?
  view_count      Int       @default(0)

  // Audit / soft delete (synced with live DB)
  deleted_at DateTime?
  version    Int       @default(1)

  // Relations
  tenant  Tenant  @relation(fields: [tenant_id], references: [id])
  offer   Offer?  @relation(fields: [offer_id], references: [id])
  partner Partner @relation(fields: [partner_id], references: [id])

  @@index([tenant_id])
  @@index([offer_id])
  @@index([partner_id])
  @@index([status])
  @@index([deleted_at])
}

// ============================================================
// 16. DocumentRegisterEntry — document versioning
// ============================================================
model DocumentRegisterEntry {
  id           String   @id @default(cuid())
  tenant_id    String
  number       String // e.g. OF-2026-001-V2
  type         String // offer | invoice | proforma | contract | spec | other
  version      Int      @default(1)
  reference_id String?
  partner_id   String?
  title        String
  status       String   @default("current") // current | superseded | archived
  created_by   String?
  metadata     String? // JSON object
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // Relations
  partner   Partner?           @relation(fields: [partner_id], references: [id])
  creator   User?              @relation(fields: [created_by], references: [id])
  revisions DocumentRevision[] @relation("DocRevDocument")

  @@index([tenant_id])
  @@index([type])
  @@index([reference_id])
  @@index([partner_id])
  @@index([status])
  @@index([number])
}

// ============================================================
// 17. DocumentRevision — revision history
// ============================================================
model DocumentRevision {
  id          String   @id @default(cuid())
  tenant_id   String
  document_id String
  version     Int
  change_note String   @default("")
  created_by  String?
  created_at  DateTime @default(now())

  // Relations
  tenant   Tenant                @relation("DocRevTenant", fields: [tenant_id], references: [id])
  document DocumentRegisterEntry @relation("DocRevDocument", fields: [document_id], references: [id], onDelete: Cascade)
  creator  User?                 @relation("DocRevCreator", fields: [created_by], references: [id])

  @@index([tenant_id])
  @@index([document_id])
  @@index([created_by])
}

// ============================================================
// 18. VaultSecret — encrypted secrets
// ============================================================
model VaultSecret {
  id               String    @id @default(cuid())
  tenant_id        String
  key              String    @unique
  description      String?
  encrypted_value  String
  category         String    @default("other") // api | smtp | database | payment | other
  last_accessed_at DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@index([tenant_id])
  @@index([key])
  @@index([category])
}

// ============================================================
// 19. ApiKey — API keys
// ============================================================
model ApiKey {
  id           String    @id @default(cuid())
  tenant_id    String
  name         String
  key_prefix   String // first 8 chars shown
  key_hash     String // full hash, never returned to client
  permissions  String // JSON array of strings
  last_used_at DateTime?
  last_used_ip String?
  active       Boolean   @default(true)
  expires_at   DateTime?
  created_at   DateTime  @default(now())

  @@index([tenant_id])
  @@index([key_prefix])
  @@index([active])
}

// ============================================================
// 20. Webhook — webhook endpoints
// ============================================================
model Webhook {
  id                String    @id @default(cuid())
  tenant_id         String
  name              String
  url               String
  events            String // JSON array of strings, e.g. ["offer.sent", "deal.won"]
  secret            String // for signing payloads
  last_triggered_at DateTime?
  last_status       Int? // HTTP status code
  active            Boolean   @default(true)
  created_at        DateTime  @default(now())

  @@index([tenant_id])
  @@index([active])
}

// ============================================================
// 21. SecuritySession — user sessions
// ============================================================
model SecuritySession {
  id           String    @id @default(cuid())
  tenant_id    String
  user_id      String
  ip           String?
  user_agent   String?
  country      String?
  created_at   DateTime  @default(now())
  last_used_at DateTime?
  expires_at   DateTime
  revoked      Boolean   @default(false)
  current      Boolean   @default(false)

  // Relations
  user User @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([user_id])
  @@index([expires_at])
  @@index([revoked])
}

// ============================================================
// 22. LoginHistoryEntry — login history
