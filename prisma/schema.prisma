// ============================================================
// 25. MailQueueEntry — mail queue
// ============================================================
model MailQueueEntry {
  id         String    @id @default(cuid())
  tenant_id  String?
  to_email   String
  subject    String
  body       String
  status     String    @default("queued") // queued | sending | sent | failed
  attempts   Int       @default(0)
  error      String?
  sent_at    DateTime?
  created_at DateTime  @default(now())

  @@index([tenant_id])
  @@index([status])
  @@index([created_at])
}

// ============================================================
// 26. ProductCatalogEntry — product catalog (base products)
// ============================================================
model ProductCatalogEntry {
  id             String   @id @default(cuid())
  tenant_id      String
  name           String
  category       String // see PRODUCT_CATEGORIES
  hs_code        String? // Harmonized System code
  description    String?
  base_unit      String // see UNITS_OF_MEASURE
  specifications String? // JSON object, e.g. { icumsa: "45", moisture: "0.10%" }
  origin_country String? // ISO alpha-2
  images         String? // JSON array of strings (URLs)
  active         Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // Relations
  tenant         Tenant          @relation(fields: [tenant_id], references: [id])
  supplierOffers SupplierOffer[]

  @@index([tenant_id])
  @@index([category])
  @@index([active])
  @@index([name])
}

// ============================================================
// 27. SupplierOffer — supplier-specific offers
// ============================================================
model SupplierOffer {
  id                  String    @id @default(cuid())
  tenant_id           String
  product_id          String // → ProductCatalogEntry
  supplier_id         String // → Partner (type supplier)
  // Identification
  offer_number        String? // supplier's own ref
  status              String    @default("active") // active | expired | on_hold | consumed
  // Pricing
  unit_price          Float
  currency            String    @default("USD")
  min_order_qty       Float?
  price_valid_until   DateTime?
  // Product details (override base product if this supplier differs)
  packaging           String? // e.g. "50 kg PP bags", "1 MT big bag"
  packing_details     String? // e.g. "palletized, stretch-wrapped"
  loadability         String? // e.g. "28 MT per 40' HC container"
  specification_notes String? // deviations from base spec
  origin_country      String?
  // Trade terms
  incoterm            String    @default("FOB") // EXW, FOB, CIF, etc.
  loading_port        String?
  delivery_port       String?
  lead_time_days      Int?
  payment_terms       String?
  // Quality
  inspection          String? // e.g. "SGS", "Bureau Veritas"
  certificate         String? // e.g. "ISO 22000", "Halal", "Organic"
  // Meta
  notes               String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  // Relations
  tenant   Tenant              @relation(fields: [tenant_id], references: [id])
  product  ProductCatalogEntry @relation(fields: [product_id], references: [id])
  supplier Partner             @relation("SupplierOfferSupplier", fields: [supplier_id], references: [id])

  @@index([tenant_id])
  @@index([product_id])
  @@index([supplier_id])
  @@index([status])
}

// ============================================================
// 28. TradeCalculation — trade cost calculations with cost lines (JSON)
// ============================================================
model TradeCalculation {
  id                  String   @id @default(cuid())
  tenant_id           String
  name                String
  // Source
  product_id          String?
  supplier_offer_id   String?
  supplier_id         String?
  buyer_id            String?
  // Quantities
  quantity            Float    @default(0)
  unit                String   @default("MT")
  num_containers      Int      @default(0)
  container_type      String?
  // Buy side
  buy_price_per_unit  Float    @default(0)
  buy_currency        String   @default("USD")
  buy_incoterm        String   @default("FOB")
  // Sell side
  sell_price_per_unit Float    @default(0)
  sell_currency       String   @default("USD")
  sell_incoterm       String   @default("CIF")
  // Transport
  transport_mode      String   @default("sea") // sea | air | land | rail
  loading_port        String?
  delivery_port       String?
  // Exchange rate
  exchange_rate       Float    @default(1.0)
  // Cost lines (JSON array of TradeCostLine)
  cost_lines          String // JSON
  // Results (computed)
  total_buy_cost      Float    @default(0)
  total_landed_cost   Float    @default(0)
  total_sell_revenue  Float    @default(0)
  gross_margin        Float    @default(0)
  margin_percent      Float    @default(0)
  // Meta
  created_by          String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  // Commission tracking (synced with live DB migration 007)
  commission_agent_id String?
  commission_type     String?
  commission_rate     Float   @default(0)

  // Relations
  tenant   Tenant   @relation(fields: [tenant_id], references: [id])
  supplier Partner? @relation("TradeCalcSupplier", fields: [supplier_id], references: [id])
  buyer    Partner? @relation("TradeCalcBuyer", fields: [buyer_id], references: [id])
  creator  User?    @relation("TradeCalcCreator", fields: [created_by], references: [id])

  @@index([tenant_id])
  @@index([supplier_id])
  @@index([buyer_id])
  @@index([created_by])
  @@index([commission_agent_id])
}

// ============================================================
// 29. PortalAccess — portal access configuration
// ============================================================
model PortalAccess {
  id                     String    @id @default(cuid())
  partner_id             String
  tenant_id              String
  tier                   String    @default("standard") // limited | standard | premium
  // Feature flags controlled by admin
  can_view_offers        Boolean   @default(false)
  can_view_documents     Boolean   @default(false)
  can_view_catalog       Boolean   @default(false)
  can_view_invoices      Boolean   @default(false)
  can_view_profile       Boolean   @default(true)
  can_view_company_info  Boolean   @default(false)
  can_submit_rfq         Boolean   @default(false)
  can_download_pdf       Boolean   @default(false)
  // Compliance exemptions (premium clients)
  exempt_kyc             Boolean   @default(false)
  exempt_document_upload Boolean   @default(false)
  exempt_location_share  Boolean   @default(false)
  // Onboarding status
  status                 String    @default("pending_approval") // pending_approval | approved | invited | active | suspended | revoked
  approved_by            String?
  approved_at            DateTime?
  invited_at             DateTime?
  welcome_email_sent     Boolean   @default(false)
  // Access credentials
  portal_email           String?
  password_hash          String?
  must_set_password      Boolean   @default(true)
  last_login_at          DateTime?
  last_login_ip          String?
  // GPS verification (migration 015_portal_access_gps_verified_at.sql).
  // Set to now() by /api/portal/log-location when source === "browser".
  // Checked by src/lib/portal/require-gps.ts to gate portal data endpoints.
  gps_verified_at        DateTime?
  // Security: lockout & token version
  locked_until           DateTime?
  failed_attempts        Int       @default(0)
  token_version          Int       @default(1)
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  // Relations
  partner        Partner         @relation(fields: [partner_id], references: [id])
  tenant         Tenant          @relation(fields: [tenant_id], references: [id])
  approver       User?           @relation("PortalApprover", fields: [approved_by], references: [id])
  kycSubmissions KycSubmission[]
  portalRfqs     PortalRfq[]

  @@index([partner_id])
  @@index([tenant_id])
  @@index([status])
  @@index([portal_email])
}

// ============================================================
// 30. DocumentTemplate — document templates
// ============================================================
model DocumentTemplate {
  id                       String   @id @default(cuid())
  tenant_id                String
  name                     String
  type                     String   @default("generic") // offer | invoice | proforma | contract | generic
  is_default               Boolean  @default(false)
  // Page layout
  page_size                String   @default("A4") // A4 | Letter
  page_margin_top          Int      @default(20) // mm
  page_margin_bottom       Int      @default(20)
  page_margin_left         Int      @default(15)
  page_margin_right        Int      @default(15)
  // Header
  header_enabled           Boolean  @default(true)
  header_height            Int      @default(30) // mm
  header_content           String   @default("") // rich text / markdown
  header_show_logo         Boolean  @default(true)
  header_show_company_name Boolean  @default(true)
  header_show_contact      Boolean  @default(true)
  // Footer
  footer_enabled           Boolean  @default(true)
  footer_height            Int      @default(20)
  footer_content           String   @default("")
  footer_show_page_number  Boolean  @default(true)
  footer_show_bank_details Boolean  @default(false)
  footer_show_tax_id       Boolean  @default(false)
  // Body styling
  body_font_family         String   @default("Inter")
  body_font_size           Int      @default(11)
  body_line_height         Float    @default(1.5)
  primary_color            String   @default("#000000") // hex
  accent_color             String   @default("#666666")
  // Table styling
  table_header_bg          String   @default("#f3f4f6")
  table_header_color       String   @default("#111827")
  table_border_color       String   @default("#e5e7eb")
  table_stripe             Boolean  @default(true)
  // Linked branding assets (memorandum + seal)
  letterhead_id            String? // ref TenantLetterhead — null = use tenant default letterhead
  seal_id                  String? // ref TenantSeal — null = use tenant default seal
  seal_enabled             Boolean  @default(true) // whether to stamp seal on this template
  // audit20 / 20-b — which tenant bank accounts (indexes into the
  // tenant.bank_accounts JSON array) this template's PDFs show. NULL = all.
  // Migration 081 added the column; without it Prisma + the supabase store
  // silently dropped this field on every save.
  selected_bank_accounts   Json?
  // audit22 "Template Studio" — extended styling (body/table/party/totals/
  // notice/title) and the persisted visual-editor layout (fields in mm).
  // NULL = built-in defaults; parsed by src/lib/utils/style-config.ts.
  style_json               Json?
  layout_json              Json?
  // Metadata
  created_by               String?
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  // Relations
  tenant     Tenant            @relation(fields: [tenant_id], references: [id])
  creator    User?             @relation("TemplateCreator", fields: [created_by], references: [id])
  letterhead TenantLetterhead? @relation(fields: [letterhead_id], references: [id], onDelete: SetNull)
  seal       TenantSeal?       @relation(fields: [seal_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([type])
  @@index([is_default])
  @@index([letterhead_id])
  @@index([seal_id])
}

// ============================================================
// 30b. TenantLetterhead — Memorandum firme (company letterhead)
// Per-tenant branded letterhead used by all document templates.
// ============================================================
model TenantLetterhead {
  id         String  @id @default(cuid())
  tenant_id  String
  name       String // e.g. "Official Letterhead 2026"
  is_default Boolean @default(false)

  // ── Company identity (overrides Tenant defaults when set) ──
  company_name                String?
  company_legal_name          String?
  company_address_line        String?
  company_city                String?
  company_postal_code         String?
  company_country             String? // ISO 3166-1 alpha-2
  company_email               String?
  company_phone               String?
  company_website             String?
  company_vat_number          String?
  company_tax_id              String?
  company_registration_number String?

  // ── Bank details (shown in footer) ──
  bank_name           String?
  bank_iban           String?
  bank_swift          String?
  bank_account_holder String?

  // ── Logo ──
  logo_url         String? // base64 data URL or remote URL
  logo_position    String  @default("left") // left | center | right
  logo_width_mm    Int     @default(40) // width in mm
  logo_height_mm   Int     @default(15) // height in mm
  logo_lock_aspect Boolean @default(true)

  // ── Branding colors ──
  primary_color    String @default("#0f766e")
  accent_color     String @default("#0d9488")
  text_color       String @default("#0f172a")
  muted_text_color String @default("#64748b")

  // ── Page layout ──
  page_size        String @default("A4") // A4 | Letter
  margin_top_mm    Int    @default(25)
  margin_bottom_mm Int    @default(25)
  margin_left_mm   Int    @default(20)
  margin_right_mm  Int    @default(20)
  header_height_mm Int    @default(35)
  footer_height_mm Int    @default(28)

  // ── Header layout ──
  header_layout            String  @default("logo-left-info-right")
  // logo-left-info-right | logo-right-info-left | logo-center | text-only | two-column
  header_show_logo         Boolean @default(true)
  header_show_company_name Boolean @default(true)
  header_show_contact      Boolean @default(true)
  header_show_vat          Boolean @default(false)
  header_divider           Boolean @default(true)
  header_divider_color     String  @default("#e2e8f0")
  header_custom_html       String? // advanced: custom HTML header

  // ── Footer layout ──
  footer_layout            String  @default("bank-contact-tax")
  // bank-contact-tax | bank-only | contact-only | tax-id-only | custom
  footer_show_bank_details Boolean @default(true)
  footer_show_contact      Boolean @default(true)
  footer_show_tax_id       Boolean @default(true)
  footer_show_page_number  Boolean @default(true)
  footer_divider           Boolean @default(true)
  footer_divider_color     String  @default("#e2e8f0")
  footer_custom_html       String? // advanced: custom HTML footer
  footer_text              String? // optional small-print line

  // ── Watermark ──
  watermark_enabled  Boolean @default(false)
  watermark_text     String?
  watermark_color    String  @default("#94a3b8")
  watermark_opacity  Float   @default(0.08) // 0.0 – 1.0
  watermark_rotation Float   @default(-45) // degrees

  // ── Typography ──
  body_font_family     String @default("Inter, system-ui, sans-serif")
  body_font_size_pt    Int    @default(11)
  heading_font_family  String @default("Inter, system-ui, sans-serif")
  heading_font_size_pt Int    @default(16)

  // ── Metadata ──
  created_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  tenant    Tenant             @relation(fields: [tenant_id], references: [id])
  creator   User?              @relation("LetterheadCreator", fields: [created_by], references: [id])
  templates DocumentTemplate[]

  @@index([tenant_id])
  @@index([is_default])
}

// ============================================================
// 30c. TenantSeal — Zigled (company seal / stamp)
// Per-tenant seal image applied to documents.
// ============================================================
model TenantSeal {
  id         String  @id @default(cuid())
  tenant_id  String
  name       String // e.g. "Official Round Seal"
  is_default Boolean @default(false)

  // ── Seal image ──
  image_url       String // base64 data URL (PNG with transparency preferred)
  image_width_mm  Int    @default(35) // rendered width in mm
  image_height_mm Int    @default(35) // rendered height in mm
  image_format    String @default("png") // png | jpg | svg

  // ── Placement ──
  position     String @default("bottom-right")
  // bottom-right | bottom-left | bottom-center | top-right | top-left | top-center
  offset_x_mm  Int    @default(0) // horizontal offset in mm (+ = right)
  offset_y_mm  Int    @default(0) // vertical offset in mm (+ = down)
  opacity      Float  @default(1.0) // 0.0 – 1.0
  rotation_deg Float  @default(0) // degrees, 0 = upright

  // ── Which document types this seal applies to (JSON array) ──
  apply_to_types String @default("[]") // e.g. ["offer","invoice","proforma"]; [] = all

  // ── Optional signature line beside seal ──
  signature_enabled Boolean @default(false)
  signature_label   String? // e.g. "Authorized signature"
  signature_name    String? // e.g. "Vladimir, Director"

  // ── Metadata ──
  created_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  tenant    Tenant             @relation(fields: [tenant_id], references: [id])
  creator   User?              @relation("SealCreator", fields: [created_by], references: [id])
  templates DocumentTemplate[]

  @@index([tenant_id])
  @@index([is_default])
}

// ============================================================
// 31. DocumentVerification — QR verification
// ============================================================
model DocumentVerification {
  id                   String    @id @default(cuid())
  tenant_id            String
  document_type        String // offer | invoice | proforma
  document_id          String
  document_number      String
  verification_code    String    @unique // unique, embedded in QR
  pdf_hash             String // SHA-256 of original PDF bytes
  pdf_size             Int
  issued_to_partner_id String?
  issued_at            DateTime  @default(now())
  // Verification tracking
  verification_count   Int       @default(0)
  last_verified_at     DateTime?
  last_verified_ip     String?
  // Status
  status               String    @default("active") // active | revoked | superseded
  created_at           DateTime  @default(now())

  // Relations
  tenant           Tenant            @relation(fields: [tenant_id], references: [id])
  issuedToPartner  Partner?          @relation("VerificationPartner", fields: [issued_to_partner_id], references: [id])
  verificationLogs VerificationLog[]

  @@index([tenant_id])
  @@index([document_type, document_id])
  @@index([verification_code])
  @@index([status])
}

// ============================================================
// 32. VerificationLog — verification logs
// ============================================================
model VerificationLog {
  id              String   @id @default(cuid())
  verification_id String
  code            String
  verified_at     DateTime @default(now())
  ip              String?
  user_agent      String?
  result          String // valid | invalid | revoked | modified
  details         String?

  // Relations
  verification DocumentVerification @relation(fields: [verification_id], references: [id], onDelete: Cascade)

  @@index([verification_id])
  @@index([code])
  @@index([result])
  @@index([verified_at])
}

// ============================================================
// 33. KycSubmission — KYC submissions
// ============================================================
model KycSubmission {
  id               String  @id @default(cuid())
  tenant_id        String
  partner_id       String
  portal_access_id String?
  status           String  @default("draft") // draft | submitted | under_review | approved | rejected | resubmit

  // Entity type
  entity_type String @default("company") // company | individual

  // Company / Individual data
  legal_name          String?
  trade_name          String?
  registration_number String?
  tax_id              String?
  vat_number          String?
  company_website     String?

  // Address
  address_line String?
  city         String?
  state        String?
  postal_code  String?
  country      String?

  // Contact person
  contact_name     String?
  contact_email    String?
  contact_phone    String?
  contact_position String?

  // Beneficial owner (for AML)
  owner_name        String?
  owner_id_type     String? // passport, id_card
  owner_id_number   String?
  owner_nationality String?
  owner_dob         String?
  owner_address     String?

  // Business details
  business_activity       String?
  expected_monthly_volume String?
  source_of_funds         String?

  // Bank
  bank_name    String?
  bank_account String?
  bank_iban    String?
  bank_swift   String?

  // Review
  reviewed_by      String?
  reviewed_at      DateTime?
  review_notes     String?
  rejection_reason String?
