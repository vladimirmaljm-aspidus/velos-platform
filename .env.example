# ── Supabase (production backend) ────────────────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # SERVER ONLY — nikad na frontend
SUPABASE_ANON_KEY=eyJ...
SUPABASE_JWT_SECRET=<your-jwt-secret>   # Project Settings → API → JWT Secret

# ── App secrets ───────────────────────────────────────────────────────────────────
# SECRET_KEY is the legacy single-secret fallback used by both the JWT
# layer and the vault/field-encryption layer. It MUST be set in every
# environment — generate with: openssl rand -hex 32
SECRET_KEY=<random 32+ char string>

# ── P0-3 / Feature 1 — vault key separation ─────────────────────────────────────
# JWT_SECRET_KEY: signs / verifies session JWTs (src/lib/auth/session.ts).
#   Falls back to SECRET_KEY when unset — set this to a DIFFERENT random
#   value so a JWT-key compromise cannot decrypt the vault, and a vault-key
#   leak cannot forge session tokens.
JWT_SECRET_KEY=<different-random-32+-char-string>
# VAULT_KEY_V2: encrypts vault secrets (src/lib/api/vault-crypto.ts) and is
#   the preferred key for AES-256-GCM. Falls back to SECRET_KEY when unset.
#   Set this to a DIFFERENT random value so the vault is decoupled from
#   JWT signing (and from field-level encryption, below).
VAULT_KEY_V2=<different-random-16+-char-string>
# VAULT_KEY_VERSION: integer key version (default "1"). During a rotation,
#   bump to the next integer, deploy, then run POST /api/vault/rotate to
#   re-encrypt vault secrets under VAULT_KEY_V2 (src/lib/api/vault-crypto.ts).
VAULT_KEY_VERSION=1
# FIELD_ENCRYPTION_KEY: encrypts per-field PII (partners.contact_email,
#   partners.phone, partners.tax_id, portal_access.portal_email,
#   settings.comms.smtp_password — see src/lib/crypto/field-encryption.ts).
#   Falls back to SECRET_KEY when unset. Set to a DIFFERENT random value
#   so a field-encryption-key compromise does NOT auto-compromise the
#   vault or JWT layer.
FIELD_ENCRYPTION_KEY=<different-random-32+-char-string>
# FIELD_HMAC_KEY: HMAC key for field-level PII lookup tokens. Falls back to
#   FIELD_ENCRYPTION_KEY when unset — set a separate value so ciphertext
#   leaks cannot forge equality-search tokens.
FIELD_HMAC_KEY=<different-random-32+-char-string>

# ── Security hardening (rate-limit IP extraction + realtime WS tickets) ────
# TRUST_PROXY_HEADERS: set to "true" only when running behind a trusted
#   reverse proxy (Vercel) so client-IP extraction honors X-Forwarded-For.
#   Leave unset otherwise — spoofable headers are then ignored.
TRUST_PROXY_HEADERS=
# WS_TICKET_SECRET: shared secret used to sign short-lived tickets for the
#   realtime WebSocket mini-service handshake (mini-services/realtime). Must
#   match the value configured on the mini-service host.
WS_TICKET_SECRET=

# ── P0-3 / Feature 4 — breach notification ─────────────────────────────────────
# Supervisory authority (DPA) email — destination of Art. 33(1) breach
# notifications. Defaults to a placeholder; surface the real address here
# in production deployments.
BREACH_NOTIFICATION_DPA_EMAIL=dpa@example.gov
# DPO / on-call security contact — Reply-To address on breach notifications.
# Falls back to NOREPLY_EMAIL then a default sentinel.
BREACH_NOTIFICATION_DPO_EMAIL=dpo@example.com
# Optional webhook (Slack / PagerDuty / Opsgenie) called by the
# breach-notification-check cron when a deadline is approaching or breached.
BREACH_NOTIFICATION_WEBHOOK_URL=

# ── Initial admin (used by POST /api/setup once) ─────────────────────────────────
# Replace with your own secure credentials before first deploy.
ADMIN_USERNAME=<your-admin-username>
ADMIN_PASSWORD=<your-secure-password>
ADMIN_EMAIL=<your-admin-email@example.com>

# ── Public URL of the deployed app ───────────────────────────────────────────
APP_BASE_URL=https://your-app.vercel.app

# ── Backend selector ─────────────────────────────────────────────────────────
# supabase = production (default)
# mock     = in-memory, no seed data (testing only)
# prisma   = legacy SQLite (deprecated)
DB_BACKEND=supabase

# ── Optional: Prisma/SQLite (only used when DB_BACKEND=prisma) ────────────────
# DATABASE_URL="file:./dev.db"

# ── Z.AI SDK (vision OCR + market news web search) ───────────────────────────
# The z-ai-web-dev-sdk looks for a `.z-ai-config` file in the project root,
# home dir, or /etc/. On serverless runtimes (Vercel) none of those are
# writable, so set these env vars instead. src/lib/ai/zai-client.ts reads
# them as a fallback when the config file is missing.
ZAI_BASE_URL=https://internal-api.z.ai/v1
ZAI_API_KEY=<your-z-ai-api-key>
